# Backend API runtime settings.
GOOGLE_PLACES_API_KEY=your_google_places_api_key
AWS_REGION=us-east-1
DYNAMODB_TABLE_PROSPECTS=prospects
DYNAMODB_TABLE_USERS=users
DYNAMODB_TABLE_USAGE_LOGS=usage_logs
DYNAMODB_TABLE_SEARCH_HISTORY=search_history
DYNAMODB_TABLE_FEEDBACK=feedback
MAX_PAGES_PER_CATEGORY=1

# Supabase service-role values are backend-only. Never expose the service role key to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe server-side billing values.
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
STRIPE_PRICE_BUSINESS_MONTHLY=price_business_monthly

FRONTEND_BASE_URL=http://localhost:3000
ADMIN_KEY=change_me
